---
import { getCollection } from "astro:content";
import "normalize.css";
import "../styles/global.css";

type LinkData = {
  id?: string;
  group?: number;
  order: number;
  title: string;
  url: string;
  themeColor: string;
  icon?: string;
};

// order 順で全リンクを取得
const linksEntries = await getCollection("links");
const links: LinkData[] = linksEntries
  .map((entry) => entry.data as LinkData)
  .sort((a, b) => a.order - b.order);

// group 番号でまとめ、グループ番号の昇順で並べる
const groupMap = new Map<number | string, LinkData[]>();
for (const link of links) {
  const key = link.group ?? "default";
  if (!groupMap.has(key)) groupMap.set(key, []);
  groupMap.get(key)!.push(link);
}
// グループを昇順ソート（数値グループを先に、"default" を後に）
const groups = [...groupMap.entries()].sort(([a], [b]) => {
  if (a === "default") return 1;
  if (b === "default") return -1;
  return Number(a) - Number(b);
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>hub.takeno.tech</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kode+Mono:wght@400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="groups-container">
      {
        groups.map(([groupKey, groupLinks]) => (
          <div class="link-group">
            {groupLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link-button"
                style={`--theme-color: ${link.themeColor};`}
              >
                <span class="theme-dot" />
                <span class="link-title">{link.title}</span>
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </body>
</html>
